# Public Supabase project settings. The publishable/anon key is intended for browser use;
# table access is restricted by the SQL migration's RLS policies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Backward-compatible alternative to NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated HTTPS hostnames allowed by /api/proxy (exact host or *.example.com).
# Keep this list limited to media origins you control or are authorized to use.
ANIVERSE_MEDIA_ALLOWED_HOSTS=
