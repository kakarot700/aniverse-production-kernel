# ─────────────────────────────────────────────────────────────────────────────
# Supabase (optional — enables watch rooms and user data)
# ─────────────────────────────────────────────────────────────────────────────
# The publishable/anon key is intended for browser use; table access is
# restricted by the SQL migration's RLS policies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Backward-compatible alternative to NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Media proxy
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated HTTPS hostnames /api/proxy may fetch from.
# Exact host (cdn.example.com) or wildcard (*.example.com).
# Keep this limited to media origins you control or are authorized to use.
ANIVERSE_MEDIA_ALLOWED_HOSTS=

# Some CDNs reject requests without a browser-like User-Agent, or require a
# specific Referer/Origin. Both are sent upstream only if set.
# ANIVERSE_MEDIA_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36
# ANIVERSE_MEDIA_REFERER=https://your-app.example.com


# ─────────────────────────────────────────────────────────────────────────────
# Stream servers — see docs/SERVERS.md
# ─────────────────────────────────────────────────────────────────────────────
# Base origin per server. Pattern: ANIVERSE_SERVER_<ID>, '-' becomes '_'.
# Only https is accepted; an http value is ignored.
#
# ANIVERSE_SERVER_ANIVERSE_ORIGIN=https://cdn.example.com   # your own HLS origin
# ANIVERSE_SERVER_VIDPLAY=https://vidplay.online
# ANIVERSE_SERVER_MCLOUD=https://mcloud.to
# ANIVERSE_SERVER_FILEMOON=https://filemoon.sx
# ANIVERSE_SERVER_DOODSTREAM=https://doodstream.com
# ANIVERSE_SERVER_STREAMTAPE=https://streamtape.com
# ANIVERSE_SERVER_VOE=https://voe.sx
# ANIVERSE_SERVER_STREAMWISH=https://streamwish.to
# ANIVERSE_SERVER_VIDHIDE=https://vidhide.com
# ANIVERSE_SERVER_MP4UPLOAD=https://mp4upload.com
# ANIVERSE_SERVER_NETU=https://netu.io
# ANIVERSE_SERVER_MIXDROP=https://mixdrop.co

# Comma-separated server ids to switch off entirely.
# ANIVERSE_SERVERS_DISABLED=netu,mixdrop

# Creative-Commons reference streams used by the `open-cinema` server.
# Default: on outside production, off in production.
# ANIVERSE_ENABLE_REFERENCE_STREAMS=true


# ─────────────────────────────────────────────────────────────────────────────
# Source map — which file each server holds for each episode
# ─────────────────────────────────────────────────────────────────────────────
# Aniverse never scrapes providers to discover stream URLs. You supply them,
# for content you are licensed to distribute. Format: docs/SERVERS.md
#
# An https endpoint you control (cached 60s, fails open):
# ANIVERSE_SOURCE_MAP_URL=https://internal.example.com/aniverse/sources.json
#
# …or inline JSON for a small deployment:
# ANIVERSE_SOURCE_MAP_INLINE={"version":1,"entries":{"anilist:16498":{"1":[{"server":"aniverse-origin","url":"https://cdn.example.com/aot/01/master.m3u8","quality":"1080p","audio":"sub"}]}}}


# ─────────────────────────────────────────────────────────────────────────────
# Environment
# ─────────────────────────────────────────────────────────────────────────────
# Extra hostnames allowed to reach the dev server (proxied previews, LAN IPs).
# ANIVERSE_DEV_ORIGINS=my-tunnel.example.com,192.168.1.50

# Clickjacking policy as CSP frame-ancestors. Unset in development so hosted
# previews can iframe the app; set this in production.
# ANIVERSE_FRAME_ANCESTORS='self'
