# ─────────────────────────────────────────────────────────────────────────────
# Catalog
# ─────────────────────────────────────────────────────────────────────────────
# No configuration required. The catalog reads AniList (https://graphql.anilist.co)
# with a Jikan/MyAnimeList fallback; both are free and unauthenticated.
# See docs/ANIME-SOURCES.md.

# ─────────────────────────────────────────────────────────────────────────────
# Stream servers  (see docs/STREAM-SERVERS.md)
# ─────────────────────────────────────────────────────────────────────────────
# JSON array of server definitions. Configure only origins you own or are
# licensed to stream from. Example file: config/stream-servers.example.json
# ANIVERSE_STREAM_SERVERS=[{"id":"studio-cdn","name":"Studio CDN","group":"Licensed","language":"sub","priority":10,"template":"https://media.example.com/anime/{slug}/e{episode3}/master.m3u8"}]

# Alternative to the inline JSON above: a path to a file with the same shape.
# ANIVERSE_STREAM_SERVERS_FILE=./config/stream-servers.json
#
# Simplest of all: set neither variable and paste your server list into
# config/stream-servers.json — the app auto-detects it. The file ships with
# placeholder brackets; the /servers page in the app shows the registry status
# and the exact JSON bracket to paste into.

# Public reference/test streams (Mux, Apple, Unified Streaming, Blender open
# movies) ship enabled so a fresh checkout can actually play video and prove
# failover works. Set to false once real servers are configured.
# ANIVERSE_ENABLE_REFERENCE_STREAMS=true

# ─────────────────────────────────────────────────────────────────────────────
# Media proxy
# ─────────────────────────────────────────────────────────────────────────────
# Extra comma-separated HTTPS hostnames allowed by /api/proxy (exact host or
# *.example.com). The static hosts of every configured stream server are added
# automatically, so this is only for hosts a template cannot express (for
# example a redirect target on a different CDN).
ANIVERSE_MEDIA_ALLOWED_HOSTS=

# ─────────────────────────────────────────────────────────────────────────────
# Supabase (optional — enables watch rooms and user data)
# ─────────────────────────────────────────────────────────────────────────────
# The publishable/anon key is intended for browser use; table access is
# restricted by the SQL migration's RLS policies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Backward-compatible alternative to NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
